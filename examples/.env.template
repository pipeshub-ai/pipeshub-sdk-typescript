PIPESHUB_BASE_URL=http://localhost:3000

# OAuth2 client credentials of an OAuth app with the client_credentials grant.
# PIPESHUB_TOKEN_URL defaults to ${PIPESHUB_BASE_URL}/api/v1/oauth2/token.
PIPESHUB_CLIENT_ID=your_client_id_here
PIPESHUB_CLIENT_SECRET=your_client_secret_here
# PIPESHUB_TOKEN_URL=http://localhost:3000/api/v1/oauth2/token

# The older examples read a JWT access token instead.
PIPESHUB_BEARER_AUTH=your_bearerauth_here

PIPESHUB_DEBUG=true

# IDs the quick-start examples read; set the ones the example you run lists in its header.
PIPESHUB_CONVERSATION_ID=      # conversation/addMessage, cancelConversationStream
PIPESHUB_MESSAGE_ID=           # message-level examples
PIPESHUB_RUN_ID=               # runId you passed to streamChat (cancelConversationStream)
PIPESHUB_AGENT_KEY=            # reserved for agent examples (the older agentConversation ones read AGENT_KEY)
PIPESHUB_KB_ID=                # knowledge base id (KB/trash/listTrash)
PIPESHUB_RECORD_ID=            # record id (getRecordById, restoreRecord, restoreRecords)
PIPESHUB_RECORD_GROUP_ID=      # connector record group (reindexRecordGroup)
PIPESHUB_CONNECTOR_ID=         # connector instance id (connectors/*)
PIPESHUB_CONNECTOR_TYPE=RSS    # connector type, e.g. RSS, Jira
PIPESHUB_FILTER_KEY=           # filter key from the connector schema (saveConnectorFilters, getFilterFieldOptions)
PIPESHUB_OAUTH_CONFIG_ID=      # saved OAuth app config id
PIPESHUB_OAUTH_CODE=           # code from the OAuth provider redirect (handleOAuthCallback)
PIPESHUB_OAUTH_STATE=          # state from the OAuth provider redirect (handleOAuthCallback)
