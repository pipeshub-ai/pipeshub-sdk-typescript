PIPESHUB_BASE_URL=http://localhost:3000

# OAuth2 client credentials of an OAuth app with the client_credentials grant.
# The examples added in SDK 1.7.1 use these. PIPESHUB_TOKEN_URL defaults to
# ${PIPESHUB_BASE_URL}/api/v1/oauth2/token.
PIPESHUB_CLIENT_ID=your_client_id_here
PIPESHUB_CLIENT_SECRET=your_client_secret_here
# PIPESHUB_TOKEN_URL=http://localhost:3000/api/v1/oauth2/token

# The older examples read a JWT access token instead.
PIPESHUB_BEARER_AUTH=your_bearerauth_here

# The personalAccessTokens examples can't use an OAuth token; they sign in with
# this user's email and password instead.
PIPESHUB_TEST_USER_EMAIL=you@example.com
PIPESHUB_TEST_USER_PASSWORD=your_password_here

PIPESHUB_DEBUG=true
PIPESHUB_KB_ID=your_kb_id_here
PIPESHUB_CONNECTOR_ID=your_connector_id
AGENT_KEY=your_agent_key_here

# Display name of a connector instance (e.g. an RSS connector). The
# reindexRecordGroup example reindexes one of its record groups.
PIPESHUB_CONNECTOR_NAME="BBC News RSS"

